# Porta em que a API vai rodar
PORT=5000

# String de conexão do MongoDB Atlas
# Pegue em: Atlas > Database > Connect > Drivers > copie a connection string
# e troque <password> pela senha do usuário do banco e adicione o nome do banco no final
MONGO_URI=mongodb+srv://<usuario>:<senha>@cluster0.xxxxx.mongodb.net/auto-history?retryWrites=true&w=majority

# Segredo usado para assinar os tokens JWT (use uma string longa e aleatória)
JWT_SECRET=troque_isso_por_uma_string_bem_grande_e_aleatoria
JWT_EXPIRES_IN=7d

# URL do frontend, usada para liberar o CORS
FRONTEND_URL=http://localhost:5173
